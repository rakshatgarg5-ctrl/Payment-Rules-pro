# Shopify (from `shopify app env` or Partner Dashboard)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=write_payment_customizations,read_payment_customizations,read_products
SHOPIFY_APP_URL=https://payment-rules-pro-production.up.railway.app

# PostgreSQL (required — Prisma session storage)
# Set BOTH in Railway → your web service → Variables.
#
# Railway Postgres plugin: use the same URL for DATABASE_URL and DIRECT_URL
# (copy DATABASE_URL from the Postgres service → Variables → DATABASE_URL).
#
# Supabase: pooler (6543) for DATABASE_URL, direct (5432) for DIRECT_URL.
#
# DATABASE_URL=
# DIRECT_URL=
